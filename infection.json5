{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["app"]
    },
    "mutators": {
        "@default": true,
        // These methods are only called from their own components; visibility mutations have no product effect.
        "ProtectedVisibility": {
            "ignore": [
                "App\\Livewire\\NetWorth\\NetWorthTracker::rules",
                "App\\Livewire\\Reports\\ReportsHub::buildNetWorthChartData"
            ]
        }
    },
    "minMsi": 100,
    "minCoveredMsi": 100,
    "timeout": 30,
    "timeoutsAsEscaped": true,
    "maxTimeouts": 0,
    "testFramework": "phpunit",
    "phpUnit": {
        "configDir": "."
    }
}
